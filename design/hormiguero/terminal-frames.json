  "status_icons": {
    "ok": {
      "unicode": "✔",
      "ascii": "[ok]",
      "color": "hoja",
      "use": "aprobado, filtro paso, merge"
    },
    "running": {
      "unicode": "◐",
      "ascii": "[..]",
      "color": "chicamocha",
      "use": "etapa en curso (modo sin animacion)"
    },
    "retry": {
      "unicode": "↻",
      "ascii": "[~]",
      "color": "chicamocha",
      "use": "FAIL o CHANGES: vuelve a la Cortadora"
    },
    "human": {
      "unicode": "⚑",
      "ascii": "[!]",
      "color": "culona",
      "use": "necesita humano"
    },
